# Copy this file to .env for local-only values.
# Never commit real tokens, passwords, or workspace-specific secrets.

# Databricks authentication examples (used by Databricks CLI if exported in your shell)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com/
DATABRICKS_TOKEN=replace-with-your-personal-access-token

# Optional application overrides
PIPELINE_ORDERS_RAW_DIR=/Volumes/workspace/sales/raw/
PIPELINE_ORDERS_BRONZE_TABLE=workspace.sales.bronze_orders
PIPELINE_ORDERS_SILVER_TABLE=workspace.sales.silver_orders
PIPELINE_ORDERS_GOLD_TABLE=workspace.sales.gold_daily_metrics
